
    <div class="page-header">
      <h1>Donate Unused Medicine</h1>
      <p>Provide details of unexpired, sealed medicine to initiate the safety review process.</p>
    </div>

    <div class="donate-layout">

      <section class="card form-card">
        <h2>Medicine Details</h2>

        <form id="donate-form" action="#" method="post" novalidate>
          <div class="form-row two-col">
            <div class="field">
              <label for="medicine-name">Medicine Name <span class="required">*</span></label>
              <input type="text" id="medicine-name" name="medicine-name" placeholder="e.g., Metformin 500mg" required>
            </div>
            <div class="field">
              <label for="category">Category <span class="required">*</span></label>
              <select id="category" name="category" required>
                <option value="" selected disabled>Select medicine category</option>
              {{#each categories}}
              <option value="{{this}}">{{this}}</option>
              {{/each}}
              </select>
            </div>
          </div>

          <div class="form-row three-col">
            <div class="field">
              <label for="batch-number">Batch Number</label>
              <input type="text" id="batch-number" name="batch-number" placeholder="e.g., B408290">
            </div>
            <div class="field">
              <label for="expiry-date">Expiry Date <span class="required">*</span></label>
              <input type="date" id="expiry-date" name="expiry-date" placeholder="MM / YYYY" required>
            </div>
            <div class="field">
              <label for="quantity">Quantity <span class="required">*</span></label>
              <input type="text" id="quantity" name="quantity" placeholder="e.g., 2 packs (20 tabs)" required>
            </div>
          </div>

          <div class="form-row">
            <div class="field">
              <label for="pincode">Pincode <span class="required">*</span></label>
              <input type="text" id="pincode" name="pincode" inputmode="numeric" maxlength="6" placeholder="e.g., 122001" autocomplete="postal-code" required>
              <span class="field-hint" id="pincode-hint" aria-live="polite"></span>
            </div>
          </div>

          <div class="form-row">
            <div class="field">
              <label for="pickup-location">Pickup City / Area <span class="required">*</span></label>
              <input type="text" id="pickup-location" name="pickup-location" placeholder="Filled from your pincode, e.g. Gurgaon, Haryana" readonly required>
            </div>
          </div>

          <div class="form-row">
            <div class="field">
              <label for="pickup-address">Full Pickup Address <span class="required">*</span></label>
              <textarea id="pickup-address" name="pickup-address" rows="2" placeholder="House/flat, street, landmark and area" required></textarea>
            </div>
          </div>

          <div class="form-row">
            <div class="field">
              <label for="notes">Optional Notes / Storage Conditions</label>
              <textarea id="notes" name="notes" rows="3" placeholder="e.g., Stored in refrigerator, box sealed..."></textarea>
            </div>
          </div>

          <div class="form-footer">
            <p class="required-note">* Required fields</p>
            <button type="submit" class="btn btn-primary">Submit Donation Listing</button>
          </div>
        </form>
      </section>

      <aside class="card guidelines-card">
        <h2>Donation Guidelines</h2>

        <ul class="guideline-list">
          <li class="guideline ok">
            <span class="g-icon" aria-hidden="true">✓</span>
            <div>
              <p class="g-title">Expiry Limit</p>
              <p class="g-text">Medicines must have at least 1 month before expiration date.</p>
            </div>
          </li>
          <li class="guideline ok">
            <span class="g-icon" aria-hidden="true">✓</span>
            <div>
              <p class="g-title">Packaging Condition</p>
              <p class="g-text">Only accept intact blisters, sealed bottles, and unopened vials.</p>
            </div>
          </li>
          <li class="guideline warn">
            <span class="g-icon" aria-hidden="true">✕</span>
            <div>
              <p class="g-title">Restricted Categories</p>
              <p class="g-text">Narcotics, custom compounded meds, and heavy sedatives cannot be shared.</p>
            </div>
          </li>
        </ul>

        <p class="guideline-footnote">
          <span class="g-icon info" aria-hidden="true">i</span>
          All listings are digitally checked and standard inspected by certified pharmacists of our partner NGOs before distribution.
        </p>
      </aside>

    </div>
