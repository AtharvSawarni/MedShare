    <div class="page-header">
      <h1>Request Medicine</h1>
      <p>Tell us who needs this medicine. A partner NGO will verify your request before dispatch.</p>
    </div>

    <div class="donate-layout">
      <section class="card form-card">
        <h2>Requester Details</h2>
        <form id="request-form" action="#" method="post" novalidate>
          <input type="hidden" id="medicine-id" name="medicineId">
          <div class="form-row two-col">
            <div class="field">
              <label for="requester-name">Name / Organization <span class="required">*</span></label>
              <input type="text" id="requester-name" name="requesterName" placeholder="e.g., Hope Clinic" required>
            </div>
            <div class="field">
              <label for="requester-type">Requester Type <span class="required">*</span></label>
              <select id="requester-type" name="requesterType" required>
                <option value="NGO">NGO</option>
                <option value="Clinic">Clinic</option>
                <option value="Patient">Individual Patient</option>
              </select>
            </div>
          </div>
          <div class="form-row two-col">
            <div class="field">
              <label for="contact">Phone or Email <span class="required">*</span></label>
              <input type="text" id="contact" name="contact" placeholder="How can we reach you?" required>
            </div>
            <div class="field">
              <label for="req-quantity">Quantity Needed <span class="required">*</span></label>
              <input type="text" id="req-quantity" name="quantity" placeholder="e.g., 1 pack" required>
            </div>
          </div>
          <div class="form-row field">
            <label for="delivery-address">Delivery Address <span class="required">*</span></label>
            <textarea id="delivery-address" name="deliveryAddress" rows="2" placeholder="Where should the medicine be delivered?" required></textarea>
          </div>
          <div class="form-row field">
            <label for="reason">Reason / Notes</label>
            <textarea id="reason" name="reason" rows="3" placeholder="Why is this medicine needed?"></textarea>
          </div>
          <div class="form-footer">
            <p class="required-note">* Required fields</p>
            <button type="submit" class="btn btn-primary">Submit Request</button>
          </div>
        </form>
      </section>

      <aside class="card guidelines-card">
        <h2>Requested Medicine</h2>
        <div id="med-summary">
          <p class="g-text">No medicine selected. Pick one from <a href="browse.html" class="accent">Browse Medicines</a>.</p>
        </div>
      </aside>
    </div>
