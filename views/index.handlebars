
    <section class="hero">
      <div class="hero-copy">
        <p class="eyebrow">Bridge the gap in healthcare</p>
        <h1>Don't waste unexpired medicines. Share them.</h1>
        <p class="hero-text">
          Every year, billions of dollars of unexpired medications are thrown away.
          MedShare connects individual donors with verified NGOs to redistribute
          lifesaving medicine safely.
        </p>
        <div class="hero-actions">
          <a href="donate.html" class="btn btn-primary"><i data-lucide="pill" aria-hidden="true"></i> Donate Medicine <i data-lucide="arrow-up-right" aria-hidden="true"></i></a>
          <a href="browse.html" class="btn btn-outline"><i data-lucide="search" aria-hidden="true"></i> Request Medicine</a>
        </div>
      </div>
      <div class="hero-media">
        <!-- Replace with a real pharmacy/donation photo -->
        <img src="photos/main.png" alt="Pharmacist organizing donated medicine on shelves">
      </div>
    </section>

    <section class="how-it-works">
      <p class="eyebrow center">Simple process</p>
      <h2>How MedShare Works</h2>
      <p class="section-subtext">A secure and compliant path from your cabinet to those who need it most.</p>

      <div class="steps">
        <article class="step-card">
          <div class="step-icon icon-list" aria-hidden="true"><i data-lucide="clipboard-list"></i></div>
          <h3>1. List Unused Medicine</h3>
          <p>Input basic details, batch numbers, and unexpired dates. Upload a photo for primary verification.</p>
        </article>
        <article class="step-card">
          <div class="step-icon icon-verify" aria-hidden="true"><i data-lucide="shield-check"></i></div>
          <h3>2. NGOs Verify &amp; Collect</h3>
          <p>Partner NGOs perform a strict standard inspection check and approve or coordinate safe collection protocols.</p>
        </article>
        <article class="step-card">
          <div class="step-icon icon-deliver" aria-hidden="true"><i data-lucide="truck"></i></div>
          <h3>3. Delivered to Patients</h3>
          <p>Verified, essential medications are distributed to people in need or clinical patients who cannot afford treatment.</p>
        </article>
      </div>
    </section>

    <section class="impact">
      <div class="impact-intro">
        <h2>MedShare Impact</h2>
        <p>Real-time statistics of our redistribution network.</p>
      </div>
      <div class="impact-stats">
        <div class="stat">
          <i data-lucide="package-check" class="stat-icon" aria-hidden="true"></i>
          <p class="stat-number">{{stats.donated}}</p>
          <p class="stat-label">Medicines Donated</p>
        </div>
        <div class="stat">
          <i data-lucide="users" class="stat-icon" aria-hidden="true"></i>
          <p class="stat-number">{{stats.fulfilled}}</p>
          <p class="stat-label">Requests Fulfilled</p>
        </div>
        <div class="stat">
          <i data-lucide="badge-check" class="stat-icon" aria-hidden="true"></i>
          <p class="stat-number">{{stats.organisations}}</p>
          <p class="stat-label">Organisations Served</p>
        </div>
      </div>
    </section>
