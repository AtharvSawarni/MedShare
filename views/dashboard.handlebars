
    <div class="page-header">
      <h1>Inventory Management</h1>
      <p>Welcome back, <strong>Red Cross Clinic Admin</strong>. Manage medicine approvals and verify active donations. <span id="dashboard-updated" class="dashboard-updated" aria-live="polite"></span></p>
    </div>

    <div class="stat-cards">
      <div class="stat-card">
        <div class="stat-card-top">
          <span class="stat-card-label">Total Medicines</span>
          <span class="trend-icon" aria-hidden="true">📈</span>
        </div>
        <p class="stat-card-number" id="stat-available">142</p>
        <p class="stat-card-sub">All medicines currently recorded</p>
      </div>

      <div class="stat-card ">
        <div class="stat-card-top">
          <span class="stat-card-label">Near Expiry (&lt;6 months)</span>
          <span class="trend-icon" aria-hidden="true">📈</span>
        </div>
        <p class="stat-card-number" id="stat-near-expiry">18</p>
        <p class="stat-card-sub">Requires immediate clinic matching</p>
      </div>

      <div class="stat-card">
        <div class="stat-card-top">
          <span class="stat-card-label">Fulfilled Requests</span>
          <span class="trend-icon" aria-hidden="true">📈</span>
        </div>
        <p class="stat-card-number" id="stat-fulfilled">1,240</p>
        <p class="stat-card-sub">Successfully shared since launch</p>
      </div>
    </div>

    <div class="dashboard-layout">

      <section class="card activity-card">
        <div class="approval-section">
          <h2>Donation Approvals</h2>
          <p class="section-subtitle">Review medicines submitted by donors.</p>
          <table class="activity-table">
            <thead>
              <tr>
                <th>Medicine</th>
                <th>Donor</th>
                <th>Qty</th>
                <th>Expiry</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody id="donation-approval-body">
              <tr><td colspan="5">Loading donations...</td></tr>
            </tbody>
          </table>
        </div>

        <div class="approval-section">
          <h2>Requester Approvals</h2>
          <p class="section-subtitle">Review requests and coordinate delivery.</p>
          <table class="activity-table">
            <thead>
              <tr>
                <th>Medicine</th>
                <th>Requester</th>
                <th>Qty</th>
                <th>Delivery Details</th>
                <th>Status</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody id="request-approval-body">
              <tr><td colspan="6">Loading requests...</td></tr>
            </tbody>
          </table>
        </div>
      </section>

      <aside class="card distribution-card">
        <h2>Category Distribution</h2>

        <div id="dist-list">
          <div class="dist-row">
            <div class="dist-label"><span>Diabetes</span><span>70%</span></div>
            <div class="dist-bar"><div class="dist-fill teal" style="width:70%"></div></div>
          </div>
          <div class="dist-row">
            <div class="dist-label"><span>Cardiology</span><span>48%</span></div>
            <div class="dist-bar"><div class="dist-fill blue" style="width:48%"></div></div>
          </div>
          <div class="dist-row">
            <div class="dist-label"><span>Antibiotics</span><span>35%</span></div>
            <div class="dist-bar"><div class="dist-fill green" style="width:35%"></div></div>
          </div>
          <div class="dist-row">
            <div class="dist-label"><span>Pain Relievers</span><span>24%</span></div>
            <div class="dist-bar"><div class="dist-fill amber" style="width:24%"></div></div>
          </div>
        </div>
      </aside>

    </div>

    <section class="card inventory-card">
      <h2>Manage Inventory</h2>
      <table class="activity-table">
        <thead>
          <tr>
            <th>Medicine</th>
            <th>Qty</th>
            <th>Expiry</th>
            <th>Location</th>
            <th>Status</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody id="inventory-body"></tbody>
      </table>
    </section>

    <dialog id="edit-dialog" class="edit-dialog">
      <form id="edit-form" novalidate>
        <h2>Edit Medicine</h2>
        <div class="form-row two-col">
          <div class="field">
            <label for="edit-name">Medicine Name</label>
            <input type="text" id="edit-name" name="name">
          </div>
          <div class="field">
            <label for="edit-category">Category</label>
            <select id="edit-category" name="category">
              {{#each categories}}
              <option value="{{this}}">{{this}}</option>
              {{/each}}
            </select>
          </div>
        </div>
        <div class="form-row three-col">
          <div class="field">
            <label for="edit-batch">Batch Number</label>
            <input type="text" id="edit-batch" name="batch">
          </div>
          <div class="field">
            <label for="edit-expiry">Expiry Date</label>
            <input type="date" id="edit-expiry" name="expiry">
          </div>
          <div class="field">
            <label for="edit-quantity">Quantity</label>
            <input type="text" id="edit-quantity" name="quantity">
          </div>
        </div>
        <div class="form-row field">
          <label for="edit-location">Location</label>
          <input type="text" id="edit-location" name="location">
        </div>
        <div class="form-row field">
          <label for="edit-address">Full Address</label>
          <textarea id="edit-address" name="address" rows="2"></textarea>
        </div>
        <div class="form-row field">
          <label for="edit-notes">Notes</label>
          <textarea id="edit-notes" name="notes" rows="2"></textarea>
        </div>
        <div class="dialog-actions">
          <button type="button" class="btn btn-outline" id="edit-cancel">Cancel</button>
          <button type="submit" class="btn btn-primary">Save Changes</button>
        </div>
      </form>
    </dialog>
